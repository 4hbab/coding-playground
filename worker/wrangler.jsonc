{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyplayground",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Public URL: https://pyplayground.<account subdomain>.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vpc_services": [
    {
      // pyplayground-app: over the "pyplayground" tunnel to app:8080 (the compose service)
      "binding": "APP",
      "service_id": "01a0ee96-6dfc-7191-ada8-003a7dee325e",
      "remote": true
    }
  ]
}
