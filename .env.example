# =============================================
# PyPlayground Environment Configuration
# =============================================
# Copy this file to .env and fill in the values:
#   copy .env.example .env
#
# Then run the server with:
#   .\start.ps1
# =============================================

# Server
PORT=8080
DB_PATH=data/playground.db

# The address visitors use. An https:// URL turns on HTTPS-only cookies and HSTS.
# Leave empty for local development (defaults to http://localhost:PORT).
PUBLIC_URL=

# The one header trusted to carry the visitor's IP. Only set this when the app is
# reachable exclusively through a proxy that sets it (the Cloudflare Worker sets X-Client-IP).
CLIENT_IP_HEADER=

# Requests per minute per IP. STRICT applies to /api/execute and /auth/*.
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_STRICT=10

# Logging: debug | info | warn | error, and text | json
LOG_LEVEL=debug
LOG_FORMAT=text

# Authentication (REQUIRED for GitHub sign-in)
# Generate a JWT secret with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# GitHub OAuth App credentials
# Create one at: https://github.com/settings/developers → New OAuth App
#   Application name: PyPlayground (or anything you like)
#   Homepage URL: http://localhost:8080
#   Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback
