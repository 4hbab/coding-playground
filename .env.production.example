# =============================================
# PyPlayground production settings (docker compose)
# =============================================
# Copy to .env.production and fill in. Never commit the real file.

# The public address (the Cloudflare Worker's URL)
PUBLIC_URL=https://pyplayground.YOUR-SUBDOMAIN.workers.dev

# The Worker overwrites this header with the visitor's real IP
CLIENT_IP_HEADER=X-Client-IP

# Generate with: openssl rand -hex 32
JWT_SECRET=

# A GitHub OAuth app just for production:
#   Homepage URL:  https://pyplayground.YOUR-SUBDOMAIN.workers.dev
#   Callback URL:  https://pyplayground.YOUR-SUBDOMAIN.workers.dev/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Requests per minute per IP (STRICT applies to /api/execute and /auth/*)
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_STRICT=10

LOG_LEVEL=info
LOG_FORMAT=json

# Token of the Cloudflare Tunnel (used by the cloudflared container)
TUNNEL_TOKEN=
